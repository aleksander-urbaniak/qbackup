# qbackup server
PORT=8787

# Optional: load a dotenv file from a custom mounted path instead of ./.env.
# QBACKUP_ENV_FILE=/config/qbackup.env
QBACKUP_SECURE_COOKIES=false
QBACKUP_COOKIE_SAMESITE=strict
QBACKUP_TRUST_PROXY=false

# Optional persistent locations.
# In Docker/Kubernetes, point these at a mounted volume if you want config/users to survive restarts.
# XDG_CONFIG_HOME=/data/.config
# XDG_DATA_HOME=/data/.local/share

# Active/default cluster.
# By default, qbackup starts with no clusters and the first cluster is created in the UI.
# Set QBACKUP_BOOTSTRAP_CLUSTER=true only if you want these values to create the first cluster automatically.
QBACKUP_BOOTSTRAP_CLUSTER=false
# KUBECTL_CONTEXT can be blank to use the current in-container kube context.
# KUBECONFIG_PATH can point at a mounted kubeconfig file. In Kubernetes, prefer the in-cluster service account/RBAC.
ACTIVE_CLUSTER_ID=example-k3s
KUBECONFIG_PATH=
KUBECTL_CONTEXT=example-k3s-admin
CLUSTER_NAME=example-k3s

# NFS Storage Target
NFS_SERVER=192.0.2.10
NFS_EXPORT_PATH=/exports/qbackup
BACKUP_ROOT=pvc-backups
ARCHIVE_EXTENSION=tgz

# Kubernetes Environment
HELPER_IMAGE=alpine:3.20
LOCAL_NFS_PREFLIGHT=mount
SCALE_CONSUMERS_FOR_BACKUP=true
KEEP_FAILED_PODS=false
AUTO_HEAL_ENABLED=false
AUTO_HEAL_RETRIES=2
# AUTO_HEAL_INTERVAL_MS=30000

# Scheduling & Retention Defaults
DEFAULT_SCHEDULE=0 2 * * *
BACKUP_CONCURRENCY=3
RETENTION_DAYS=14
